{
  "schema_version": 1,
  "contract": "Routes de preuve choisies explicitement à partir d'assertions candidates versionnées. Les all_of ne sont pas générés des labels bruts requires_evidence. Aucune opération n'est déclarée exécutée.",
  "operations": [
    {
      "id": "operation:interactive-symbolic-audio-boundary",
      "question": "La continuité des événements symboliques et celle du signal concordent-elles au raccord ?",
      "scope_note": "Étude d'un raccord localisé et des variantes comparables ; pas une preuve de comportement du moteur de jeu.",
      "tasks": [
        {
          "id": "task:encoded-events",
          "question": "Quels événements de notes sont encodés dans la fenêtre ?",
          "assertion_refs": [
            {
              "assertion_id": "candidate-assertion:histoire-et-musique-interactive-2026-11-28:0006",
              "material_id": "material:0000279",
              "material_revision": 1,
