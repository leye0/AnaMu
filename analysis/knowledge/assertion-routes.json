            }
          ],
          "proof_routes": [
            {
              "id": "midi-inventory",
              "all_of": [
                "midi_note_events_verified"
              ],
              "candidate_outputs_only": [
                "localized_encoded_attacks"
              ],
              "does_not_establish": [
                "audible_tail_continuity"
              ]
            }
          ],
          "cannot_establish": [
            "acoustic_continuity"
          ],
          "depends_on": []
        },
